{
  "name": "playwright-bdd-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript + Cucumber BDD Test Automation Framework",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:chrome": "cross-env BROWSER=chromium cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:parallel": "cucumber-js --parallel 2",
    "report": "node src/utils/generateReport.js",
    "test:report": "npm run test; npm run report",
    "clean": "rimraf reports/* && mkdir -p reports/screenshots"
  },
  "dependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.45.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "multiple-cucumber-html-reporter": "^3.6.2",
    "playwright": "^1.45.0",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "winston": "^3.13.0"
  }
}
